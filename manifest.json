{
  "manifest_version": 3,
  "name": "Block AI Slop",
  "short_name": "AI Slop",
  "description": "Hides AI-generated comments on YouTube, X, Facebook, Instagram and LinkedIn. Replies stay visible. Runs entirely on your device.",
  "version": "1.0.0",
  "homepage_url": "https://blockaislop.app",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Block AI Slop",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.instagram.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/settings.js",
        "src/detector.js",
        "src/sites.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
